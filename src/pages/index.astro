---
import {
  ArrowUpRight,
  ArrowDown,
  Github,
  Command,
  Monitor,
  Code2,
} from "lucide-astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import DownloadButtons from "../components/DownloadButtons.astro";
import ProductFeatures from "../components/ProductFeatures.astro";
import { featuredProduct as product } from "../data/products.mjs";
---

<SiteLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div
      class="hero-art"
      role="img"
      aria-label={`${product.name} 的真实界面`}
      style={`--hero-image: url('${product.screenshot}')`}
    ></div>
    <div class="container hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> BLADEMAINER 出品 · 开源
        {product.category}
      </p>
      <h1 id="hero-title">{product.name}</h1>
      <p class="hero-tagline">{product.tagline}</p>
      <p class="hero-description">{product.description}</p>
      <DownloadButtons />
    </div>
    <a class="hero-scroll" href="#features" aria-label="向下查看功能">
      <ArrowDown size={18} />
      <span>SCROLL TO EXPLORE</span>
    </a>
    <span class="hero-side-note">BUILT FOR MAC. OPEN BY DESIGN.</span>
  </section>
  <div class="product-facts">
    <div class="container facts-inner">
      <span>
        <Monitor size={18} />为 macOS 而生
      </span>
      <span>
        <Command size={18} />
        Apple Silicon + Intel
      </span>
      <span>
        <Code2 size={18} />
        MIT 开源
      </span>
      <a href={product.repository} target="_blank" rel="noopener noreferrer">
        <Github size={18} />在 GitHub 查看源码 <ArrowUpRight size={14} />
      </a>
    </div>
  </div>
  <ProductFeatures />
  <section class="workflow-section section">
    <div class="container workflow-grid">
      <div class="workflow-copy">
        <p class="eyebrow">CAPTURE. ANNOTATE. SHARE.</p>
        <h2>
          不用多说，
          <br />
          一张图就明白。
        </h2>
        <p>
          给同事讲清一个问题，记录一闪而过的想法，或把操作步骤分享出去。截图之后，就在画面上把重点说清楚。
        </p>
        <a class="text-link" href="/apps/mac-screen-capture/">
          看看它能做什么 <ArrowUpRight size={18} />
        </a>
        <div class="workflow-note">
          <span>⌘ Z</span>撤销编辑，保留灵感。
        </div>
      </div>
      <figure class="product-figure">
        <img
          src="/assets/capture-main.png"
          alt="MacScreenCapture 截图界面，包含全屏、窗口、区域模式和高级工具"
          width="1200"
          height="904"
          loading="lazy"
        />
        <figcaption>真实应用界面 · 截图与高级工具</figcaption>
      </figure>
    </div>
  </section>
  <section class="brand-section section">
    <div class="container brand-section-inner">
      <p class="eyebrow">SMALL TOOLS. REAL PROBLEMS.</p>
      <h2>
        把想法做成
        <br />
        顺手的工具。
      </h2>
      <div>
        <p>
          这里是 Blademainer 的软件与开发记录。
          <br />
          从一个真实需求出发，把工具一点点打磨好。
        </p>
        <a class="text-link" href="/apps/">
          探索软件 <ArrowUpRight size={18} />
        </a>
        <a class="text-link muted-link" href="/blog/">
          阅读开发博客 <ArrowUpRight size={18} />
        </a>
      </div>
      <span class="brand-watermark" aria-hidden="true">
        B.
      </span>
    </div>
  </section>
</SiteLayout>
