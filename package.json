{
  "name": "blademainer-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build && node scripts/check-build.mjs"
  },
  "dependencies": {
    "astro": "^7.4.12",
    "cheerio": "^1.1.2",
    "katex": "^0.16.22",
    "lucide-astro": "^0.468.0",
    "plantuml-encoder": "^1.4.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.8.1"
  }
}
